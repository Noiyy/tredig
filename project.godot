; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Tredig"
run/main_scene="uid://sxummovykd5b"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="uid://tokcwf0wdwti"
config/macos_native_icon="res://assets/images/logo-icon2.icns"
config/windows_native_icon="res://assets/images/logo-icon2.ico"

[autoload]

Localization="*res://scripts/localization.gd"
UserSettings="*res://scripts/user_settings.gd"
Music="*res://scenes/music.tscn"
AudioManager="*res://scenes/audio_manager.tscn"
ExpoSandbox="*res://scenes/expo_sandbox.tscn"
UI="*res://scripts/ui.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[editor]

version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/script-ide/plugin.cfg")

[gui]

theme/custom="res://ui_theme.tres"

[internationalization]

locale/fallback="en"
locale/translations_pot_files=PackedStringArray("res://scenes/main_menu.tscn", "res://scenes/settings_menu.tscn", "res://scenes/pause_menu.tscn", "res://scenes/hud.tscn", "res://scenes/game_overlay.tscn", "res://scenes/skill_card_pick.tscn", "res://scenes/bonus_hud.tscn", "res://scripts/skill_registry.gd", "res://scripts/settings_menu.gd", "res://scripts/main_menu.gd", "res://scripts/game_overlay.gd", "res://scripts/skill_card_pick.gd", "res://scripts/hud.gd")

